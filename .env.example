# Copy to .env for local runs (never commit .env). In GitHub, add these as repository secrets.

# Required: SEC asks for a name and contact email in the User-Agent
SEC_USER_AGENT="Petra dst-agent you@example.com"

# Discord delivery
DISCORD_WEBHOOK_URL=
DISCORD_ALERTS_WEBHOOK_URL=   # optional: separate channel for radar alerts
DISCORD_BOT_TOKEN=            # only for the interactive bot

# Headline sentiment: set one (Anthropic is used first if both are set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4o-mini

# Connector + Discord agent (python -m src.server)
MCP_SECRET=                   # long random string; connector URL = http://host/<MCP_SECRET>/mcp
ALLOWED_USER_IDS=             # your Discord user ID (Developer Mode > right-click you > Copy User ID)
AGENT_CHANNEL_IDS=            # optional: channel where every message goes to the agent
# AGENT_MODEL=claude-sonnet-5-5
GITHUB_TOKEN=                 # fine-grained PAT, this repo only, Contents read/write (to log ideas)
# DATA_SOURCE=local           # read data/ and logs/ from this folder instead of GitHub

# Risk rules (enforced in code)
# RISK_MAX_POSITION_PCT=5
# RISK_MAX_STOP_PCT=15
# RISK_MIN_PRICE=5
# RISK_MIN_MARKET_CAP=300e6
# RISK_MAX_IDEAS_PER_WEEK=5

# Optional tuning
# BENCHMARK=QQQ
# RADAR_MOVE_PCT=4
# RADAR_NEWS_SPIKE=5
