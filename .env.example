# Copy to .env for local runs (never commit .env). In GitHub, add these as repository secrets.

# Required: SEC asks for a name and contact email in the User-Agent
SEC_USER_AGENT="Petra dst-agent you@example.com"

# Discord delivery
DISCORD_WEBHOOK_URL=
DISCORD_ALERTS_WEBHOOK_URL=   # optional: separate channel for radar alerts
DISCORD_BOT_TOKEN=            # only for the interactive bot

# Headline sentiment: set one (Anthropic is used first if both are set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4o-mini

# Optional tuning
# BENCHMARK=QQQ
# RADAR_MOVE_PCT=4
# RADAR_NEWS_SPIKE=5
